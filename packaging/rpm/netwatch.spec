# Self-contained spec: NetWatch is pure Python, so the package is assembled by
# copying files; only rpm-build, make and python3 are needed to build it.
#   Build:   make rpm          (or: rpmbuild -ba packaging/rpm/netwatch.spec with the tarball in SOURCES)

# Fall back to computing these when python3-rpm-macros is not installed.
%{!?python3_sitelib: %global python3_sitelib %(python3 -c "import sysconfig; print(sysconfig.get_path('purelib', 'posix_prefix', vars={'base': '/usr'}))")}
%{!?python3_version: %global python3_version %(python3 -c "import sys; print('%d.%d' % sys.version_info[:2])")}

Name:           netwatch
Version:        1.1.0
Release:        1%{?dist}
Summary:        Local-first network connectivity and outage monitor (GTK4/Libadwaita)

License:        MIT
URL:            https://github.com/netwatch-app/netwatch
Source0:        %{name}-%{version}.tar.gz
BuildArch:      noarch

BuildRequires:  python3
BuildRequires:  make

Requires:       python(abi) = %{python3_version}
Requires:       python3-gobject >= 3.42
Requires:       python3-cairo
Requires:       gtk4 >= 4.12
Requires:       libadwaita >= 1.4
Requires:       iputils
Requires:       hicolor-icon-theme
Recommends:     NetworkManager
Recommends:     (pipewire-utils or pulseaudio-utils or alsa-utils)
Suggests:       iw

%description
NetWatch continuously monitors internet connectivity, detects outages,
measures latency and packet loss, records a local SQLite history and
generates TXT, CSV and HTML reports. It distinguishes "no internet" from
"not connected" and from periods when the application was not running.

%prep
%autosetup -n %{name}-%{version}

%build
# Nothing to compile (pure Python); bytecode is generated by RPM's brp scripts.

%install
mkdir -p %{buildroot}%{python3_sitelib}
cp -a netwatch %{buildroot}%{python3_sitelib}/
find %{buildroot}%{python3_sitelib} -name __pycache__ -prune -exec rm -rf {} +
install -Dm755 /dev/stdin %{buildroot}%{_bindir}/netwatch <<'PY'
#!/usr/bin/python3
from netwatch.main import main

raise SystemExit(main())
PY
make install-data DESTDIR=%{buildroot} PREFIX=%{_prefix}

%check
if command -v desktop-file-validate >/dev/null; then
  desktop-file-validate %{buildroot}%{_datadir}/applications/io.github.netwatch.NetWatch.desktop
fi
PYTHONPATH=%{buildroot}%{python3_sitelib} python3 -c "import netwatch.monitor.engine, netwatch.stats, netwatch.reports"

%files
%license LICENSE
%doc README.md
%{_bindir}/netwatch
%{_bindir}/netwatch-update
%{python3_sitelib}/netwatch/
%{_datadir}/applications/io.github.netwatch.NetWatch.desktop
%{_datadir}/metainfo/io.github.netwatch.NetWatch.metainfo.xml
%{_datadir}/icons/hicolor/scalable/apps/io.github.netwatch.NetWatch.svg
%{_datadir}/icons/hicolor/symbolic/apps/io.github.netwatch.NetWatch*-symbolic.svg

